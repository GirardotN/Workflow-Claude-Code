# ==============================================================================
# Configuration de l'Orchestrateur Multi-Agents Claude & TypeSafe Jev
# ==============================================================================

# Clé API pour TypeSafe Jev (System One)
# Obtenue sur https://typesafe.ai
TYPESAFE_API_KEY=votre_cle_typesafe_ici

# URL des endpoints Jev
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_FALLBACK_URL=https://api.typesafe.ai/v1/decide

# Chemin personnalisé vers le binaire Claude Code CLI (si hors PATH)
# Exemples :
# CLAUDE_BIN=/home/depinfo/.config/Claude/claude-code/2.1.260/claude
# CLAUDE_BIN=/home/user/.local/bin/claude
CLAUDE_BIN=

# Timeout en secondes pour chaque exécution du CLI Claude (défaut: 180s)
CLAUDE_TIMEOUT_SECONDS=180

# Nombre maximum de cycles de feedback avant arrêt d'urgence (Circuit Breaker)
MAX_WORKFLOW_RETRIES=4

# Mode simulation / mock (1 pour activer sans appels réseau/CLI réels, 0 pour production)
MOCK_SERVICES=0

# Délais par rôle (secondes) : développement, exploration/spécification, autres (revues, doc)
CLAUDE_TIMEOUT_DEV_SECONDS=900
CLAUDE_TIMEOUT_SPEC_SECONDS=300
# Reprises sur erreur transitoire de Claude (surcharge serveur, 5xx)
CLAUDE_MAX_RETRIES=2

# 1 = laisse passer ANTHROPIC_API_KEY & co au CLI Claude (FACTURATION À L'USAGE). Défaut : 0 (abonnement uniquement)
ALLOW_API_KEY=0
